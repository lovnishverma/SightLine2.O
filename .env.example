# SIGHTLINE Core Configuration
SIGHTLINE_MODEL_NAME=microsoft/Florence-2-large-ft
SIGHTLINE_CAPTURE_INTERVAL=3.0
SIGHTLINE_SCENE_THRESHOLD=0.10
SIGHTLINE_DEBOUNCE_MS=800
SIGHTLINE_MAX_DIM=768
SIGHTLINE_HASH_SIZE=16
SIGHTLINE_TTS_TIMEOUT=12.0
SIGHTLINE_TTS_RATE=+8%
SIGHTLINE_AUDIO_FORMAT=mp3
SIGHTLINE_MAX_QUEUE_SIZE=3

# Official iNSIGHTS Integration (Build With Bharat 3.0)
# Provider options: 'live' (official endpoint) or 'mock' (offline development/testing)
INSIGHTS_ENABLED=true
INSIGHTS_PROVIDER=live

# Optional authentication token (if provided by hackathon mentors or participants)
INSIGHTS_API_KEY=

# Official Base44 App ID and Core InvokeLLM Endpoint
INSIGHTS_APP_ID=6960af55d740f6d891a60e24
INSIGHTS_ENDPOINT=https://insights-ai.info/api/apps/6960af55d740f6d891a60e24/integration-endpoints/Core/InvokeLLM

# Research Execution & Cache Parameters
INSIGHTS_TIMEOUT=15.0
INSIGHTS_CACHE_TTL=1800
INSIGHTS_MAX_SOURCES=5
INSIGHTS_MODEL=gemini_3_flash

